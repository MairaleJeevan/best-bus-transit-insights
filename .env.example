# ===========================================================
# BEST Bus Transit Insights - Configuration
# ===========================================================

# Server Settings
FLASK_ENV=development
PORT=5000
DEBUG=True

# Data Source: "csv" or "google_sheets"
DATA_SOURCE=csv

# Path to CSV data file (used when DATA_SOURCE=csv or fallback)
CSV_DATA_PATH=data/sample_data.csv

# Google Sheets Configuration (used when DATA_SOURCE=google_sheets)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_RANGE=Form Responses 1!A:Z

# Auto-Refresh Settings (seconds; 0 = off)
AUTO_REFRESH_INTERVAL=0
